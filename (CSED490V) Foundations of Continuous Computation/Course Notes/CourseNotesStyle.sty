% Circled division: build an obelus inside the same circle as \ominus.
% This matches the weight and dimensions of the other circled operators.
\RequirePackage{tikz}
\makeatletter
\newcommand{\odiv}{\mathbin{\mathpalette\courseodivaux\relax}}
\newcommand{\courseodivaux}[2]{%
  \tikz[baseline=(sym.base),inner sep=0pt]{%
    \node[inner sep=0pt,outer sep=0pt] (sym) {$\m@th#1\ominus$};%
    \fill (sym.center) ++(0,0.20em) circle[radius=0.035em];%
    \fill (sym.center) ++(0,-0.20em) circle[radius=0.035em];%
  }%
}
\makeatother

