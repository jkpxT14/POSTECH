% Match the Course Notes' institutional identity.
\definecolor{POSTECHRed}{RGB}{166,25,85}
\newcommand{\institutiontext}[2]{\texorpdfstring{\textcolor{#1}{#2}}{#2}}
\DeclareRobustCommand{\PohangUniversityOfScienceAndTechnology}{%
  \institutiontext{POSTECHRed}{Pohang University of Science and Technology}}

% Standard MATH000 notation, plus the course-specific notation table.
\newcommand{\N}{\mathbb{N}}
\newcommand{\Nzero}{\mathbb{N}_0}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\Rc}{\mathbb{R}_C}
\newcommand{\A}{\mathcal{A}}
\newcommand{\indicator}[1]{\mathds{1}_{#1}}
\DeclareMathOperator{\rnd}{rnd}
\DeclareMathOperator{\fma}{fma}
\DeclareMathOperator{\ulp}{ulp}
\DeclareMathOperator{\fasttwosum}{fast2sum}
% Same primary circled obelus as CourseNotesStyle v9.
\newcommand{\odiv}{\mathbin{\mathpalette\courseodivaux\relax}}
\makeatletter
\newcommand{\courseodivaux}[2]{%
  \def\courseodivfactor{1}%
  \ifx#1\scriptstyle\def\courseodivfactor{.7}\fi
  \ifx#1\scriptscriptstyle\def\courseodivfactor{.5}\fi
  \tikz[baseline=(sym.base),inner sep=0pt]{%
    \node[inner sep=0pt,outer sep=0pt] (sym) {$\m@th#1\ominus$};%
    \begin{scope}[shift={(sym.center)},scale=\courseodivfactor]
      \fill (0,0.195em) circle[radius=0.053em];%
      \fill (0,-0.195em) circle[radius=0.053em];%
    \end{scope}%
  }%
}
\makeatother

% Inline program identifiers/keywords use unobtrusive LM monospaced type.
\DeclareRobustCommand{\code}[1]{\texttt{#1}}

\newcommand{\homeworktitle}[1]{%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{1.1cm}
    {\LARGE\bfseries #1\par}
    \vspace{0.25cm}
    {\large for (CSED490V) Foundations of Continuous Computation\par}
    \vspace{0.75cm}
    {\normalsize Jungwoo Kim\\
     Department of Mathematics\\
     \PohangUniversityOfScienceAndTechnology\par}
  \end{center}
  \vspace{0.45cm}
}

\newcommand{\problemheading}[1]{%
  \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
  \textbf{Problem #1.}\hspace{0.5em}\ignorespaces}
\newenvironment{problem}[2][]{%
  \ifstrempty{#1}{\problemheading{#2}}{\problemheading{#2.\ (#1)}}%
}{\par\vspace{6pt}}
\newenvironment{solution}[1][]{%
  \par\Needspace{6\baselineskip}\vspace{6pt}\noindent
  \ifstrempty{#1}{\textit{Solution.}}{\textit{Solution #1.}}%
  \hspace{0.5em}\ignorespaces
}{\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}
\newenvironment{hint}{%
  \par\Needspace{3\baselineskip}\vspace{4pt}\noindent
  \textit{Hint.}\hspace{0.5em}\ignorespaces
}{\par\vspace{4pt}}
\newenvironment{remark}{%
  \par\Needspace{3\baselineskip}\vspace{4pt}\noindent
  \textit{Remark.}\hspace{0.5em}\ignorespaces
}{\par\vspace{6pt}}

\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{%
  label=(\alph*),leftmargin=2.5em,labelsep=0.6em,
  itemsep=0.3em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{%
  label=(\arabic*),leftmargin=2.5em,labelsep=0.6em,
  itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\setlist[itemize]{leftmargin=2em,topsep=3pt,itemsep=2pt,parsep=0pt}
\setlength{\parskip}{0pt}
\setlength{\parindent}{1.5em}
\raggedbottom

% Match CN v9/MATH000 topmarks and page numbers. Homework-specific right head.
