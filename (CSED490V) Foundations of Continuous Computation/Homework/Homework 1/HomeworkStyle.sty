% The course identity, notation, typefaces, page margins, and running heads
% follow CourseNotesStyle v9 (2026/10/27) and (MATH000) Mathematical Language.
% Problem/Solution/Hint follow the same-line MATH200/MATH261 document family.
\RequirePackage[a4paper,margin=1in]{geometry}
