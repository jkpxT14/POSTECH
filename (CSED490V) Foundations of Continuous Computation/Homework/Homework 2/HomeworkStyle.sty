\newcommand{\odiv}{\mathbin{\mathpalette\courseodivaux\relax}}
\makeatletter
\newcommand{\courseodivaux}[2]{%
  \def\courseodivfactor{1}%
  \ifx#1\scriptstyle\def\courseodivfactor{.7}\fi
  \ifx#1\scriptscriptstyle\def\courseodivfactor{.5}\fi
  \tikz[baseline=(sym.base),inner sep=0pt]{%
    \node[inner sep=0pt,outer sep=0pt] (sym) {$\m@th#1\ominus$};%
    \begin{scope}[shift={(sym.center)},scale=\courseodivfactor]
      \fill (0,0.195em) circle[radius=0.053em];%
      \fill (0,-0.195em) circle[radius=0.053em];%
    \end{scope}%
  }%
}
\makeatother

% Code has a distinct but restrained Latin Modern Typewriter face.
\DeclareRobustCommand{\code}[1]{\texttt{#1}}

\newcommand{\homeworktitle}[1]{%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{1.1cm}
    {\LARGE\bfseries #1\par}
    \vspace{0.25cm}
    {\large for (CSED490V) Foundations of Continuous Computation\par}
    \vspace{0.75cm}
    {\normalsize Jungwoo Kim\\Department of Mathematics\\
      \PohangUniversityOfScienceAndTechnology\par}
  \end{center}
  \vspace{0.45cm}
}

\newcommand{\problemheading}[1]{%
  \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
  \textbf{Problem #1.}\hspace{0.5em}\ignorespaces}
\newenvironment{problem}[2][]{%
  \ifstrempty{#1}{\problemheading{#2}}{\problemheading{#2.\ (#1)}}%
}{\par\vspace{6pt}}
\newenvironment{solution}[1][]{%
  \par\Needspace{3\baselineskip}\vspace{6pt}\noindent
  \ifstrempty{#1}{\textit{Solution.}}{\textit{Solution #1.}}%
  \hspace{0.5em}\ignorespaces
}{\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}
\newenvironment{hint}{%
  \par\Needspace{3\baselineskip}\vspace{4pt}\noindent
  \textit{Hint.}\hspace{0.5em}\ignorespaces
}{\par\vspace{4pt}}
\newenvironment{remark}{%
  \par\Needspace{3\baselineskip}\vspace{4pt}\noindent
  \textit{Remark.}\hspace{0.5em}\ignorespaces
}{\par\vspace{6pt}}

