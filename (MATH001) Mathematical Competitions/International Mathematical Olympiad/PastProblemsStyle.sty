% List roles as specified by MATH000.
\newlist{problemitems}{itemize}{1}
\setlist[problemitems]{
    label=\textbullet,leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt
}
\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{
    label=(\arabic*),leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left
}
\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{
    label=(\alph*),leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left
}
\newlist{problemclauses}{enumerate}{1}
\setlist[problemclauses]{
    label=(\roman*),leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left
}

% Compact contents: parts and years only, without printed year headings.
