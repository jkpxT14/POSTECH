\setlength{\cftaftertoctitleskip}{0.65em}
\setlength{\cftbeforepartskip}{0.25em}
\setlength{\cftpartindent}{0pt}
\setlength{\cftpartnumwidth}{0pt}
\renewcommand{\cftpartfont}{\normalfont\bfseries}
\renewcommand{\cftpartpagefont}{\normalfont\bfseries}
\setlength{\cftbeforesecskip}{0pt}
\setlength{\cftsecindent}{1.55em}
\setlength{\cftsecnumwidth}{0pt}
\renewcommand{\cftsecfont}{\normalfont}
\renewcommand{\cftsecpagefont}{\normalfont}

% Both competition and shortlist use YYYY.N identifiers; 
% shortlist labels are of the form YYYY.A1, YYYY.C1, YYYY.G1, YYYY.N1.
\newcommand{\problemcategory}{competition}
\makeatletter
\newcommand{\problemheading}[2]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \phantomsection
    \def\@currentlabel{#1.#2}%
    \label{imo:\problemcategory:#1:#2}%
    \textbf{Problem #1.#2.}%
    \hspace{0.5em}\ignorespaces
}
\makeatother
\newenvironment{problem}[2]
    {\problemheading{#1}{#2}}
    {\par\vspace{6pt}}

% The only printed headings are the two parts; years remain navigation anchors.
\newcommand{\competitionpart}[2]{%
    \par\Needspace{4\baselineskip}%
    \phantomsection
    \addcontentsline{toc}{part}{Part #1.\space #2}%
    \vspace{5pt}\noindent{\large\bfseries Part #1. #2}\par\vspace{1pt}%
}
\newcommand{\competitionyear}[1]{%
    \renewcommand{\problemcategory}{competition}%
    \par\phantomsection
    \addcontentsline{toc}{section}{#1}%
}
% Part II is inactive until official shortlist inputs are added.
\newcommand{\shortlistyear}[1]{%
    \renewcommand{\problemcategory}{shortlist}%
    \par\phantomsection
    \addcontentsline{toc}{section}{#1}%
}
\newcommand{\shortlistcategory}[2]{%
    \phantomsection\pdfbookmark[2]{#2}{imo-shortlist-#1-#2}%
}

