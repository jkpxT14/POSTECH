% Problem lists.
\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{
    label=(\arabic*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{
    label=(\alph*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

% KUMC problem identifiers use YYYY.Division.Problem, e.g. 2025.2.1.
% No visible year or division heading is required in the final document.
\makeatletter
\newcommand{\problemheading}[3]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \phantomsection
    \def\@currentlabel{#1.#2.#3}%
    \label{kumc:#1:#2:#3}%
    \textbf{#1.#2.#3.}%
    \hspace{0.5em}\ignorespaces
}
\makeatother

\newenvironment{problem}[3]
    {\problemheading{#1}{#2}{#3}}
    {\par\vspace{6pt}}

% Optional year bookmark for navigation without a printed section heading.
\newcommand{\competitionyear}[1]{%
    \phantomsection
    \pdfbookmark[1]{#1}{kumc-year-#1}%
    \par\addvspace{8pt}%
}

% Kept available if a separate solution document is introduced later.
\newenvironment{solution}
    {\par\Needspace{3\baselineskip}\vspace{6pt}\noindent\textit{Solution.}\hspace{0.5em}\ignorespaces}
    {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}

