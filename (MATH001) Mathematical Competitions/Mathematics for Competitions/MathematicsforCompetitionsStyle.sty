% Optional illustrative problems and solutions within the theoretical text.
\newcommand{\problemheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Problem #1.}\hspace{0.5em}\ignorespaces
}
\newenvironment{problem}[1]
    {\problemheading{#1}}{\par\vspace{6pt}}
\newenvironment{pastproblem}[1]
    {\problemheading{#1}}{\par\vspace{6pt}}

\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{label=(\arabic*),leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{label=(\alph*),leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\newlist{bookitems}{enumerate}{1}
\setlist[bookitems]{label=(\arabic*),leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\newlist{conditionlist}{enumerate}{1}
\setlist[conditionlist]{label=(\roman*),leftmargin=2.5em,labelsep=0.6em,
    itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}

\newif\ifnumberedsolutions
\numberedsolutionsfalse
\newcounter{solutionnumber}
\newenvironment{solutions}
    {\setcounter{solutionnumber}{0}\numberedsolutionstrue}
    {\numberedsolutionsfalse}
\newenvironment{solution}
    {\par\Needspace{3\baselineskip}\vspace{6pt}\noindent
        \ifnumberedsolutions
            \stepcounter{solutionnumber}\textit{Solution \arabic{solutionnumber}.}%
        \else
            \textit{Solution.}%
        \fi
        \hspace{0.5em}\ignorespaces}
    {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}
\newenvironment{hint}
    {\par\Needspace{2\baselineskip}\vspace{4pt}\noindent
        \textit{Hint.}\hspace{0.5em}\ignorespaces}
    {\par\vspace{4pt}}

