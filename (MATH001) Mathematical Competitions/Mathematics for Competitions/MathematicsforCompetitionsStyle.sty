% Mathematical environments: aligned with the existing book.
\newtheoremstyle{competitionsplain}
    {6pt}{6pt}{\itshape}{}{\bfseries}{}{\newline}
    {\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\newtheoremstyle{competitionsdefinition}
    {6pt}{6pt}{}{}{\bfseries}{}{\newline}
    {\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\newtheoremstyle{competitionssameline}
    {6pt}{6pt}{}{}{\itshape}{.}{0.5em}
    {\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}

\renewenvironment{proof}[1][Proof]
    {\par\Needspace{3\baselineskip}\noindent\textit{#1.}\hspace{0.5em}\ignorespaces}
    {\hfill$\square$\par}

\theoremstyle{competitionsdefinition}
\newtheorem{definition}{Definition}[chapter]
\theoremstyle{competitionsplain}
\newtheorem{theorem}[definition]{Theorem}
\newtheorem{proposition}[definition]{Proposition}
\newtheorem{lemma}[definition]{Lemma}
\newtheorem{corollary}[definition]{Corollary}
\newtheorem{conjecture}[definition]{Conjecture}
\newtheorem{hypothesis}[definition]{Hypothesis}
\theoremstyle{competitionsdefinition}
\newtheorem{formula}[definition]{Formula}
\newtheorem{fact}[definition]{Fact}
\newtheorem{openproblem}[definition]{Open Problem}
\newtheorem{algorithm}[definition]{Algorithm}
\theoremstyle{competitionssameline}
\newtheorem*{remark}{Remark}
\newtheorem*{idea}{Idea}
\newtheorem*{strategy}{Strategy}
\newtheorem*{tactic}{Tactic}

