% Four-course structure. Numbered mathematical items use course-local labels.
\newcounter{course}
\newcounter{mathitem}
\renewcommand{\themathitem}{\arabic{course}.\arabic{mathitem}}
\renewcommand{\theHmathitem}{\arabic{course}.\arabic{mathitem}}

\newcommand{\preliminarypart}[1]{%
  \clearpage
  \setcounter{course}{0}%
  \setcounter{mathitem}{0}%
  \phantomsection
  \addcontentsline{toc}{part}{#1}%
  \thispagestyle{plain}%
  \vspace*{0.22cm}%
  {\noindent\LARGE\bfseries #1\par}%
  \vspace{0.34cm}%
  \hrule height 0.4pt
  \vspace{0.52cm}%
}
\newcommand{\coursepart}[2]{%
  \clearpage
  \setcounter{course}{#1}%
  \setcounter{mathitem}{0}%
  \phantomsection
  \addcontentsline{toc}{part}{Part #1\space #2}%
  \thispagestyle{plain}%
  \vspace*{0.22cm}%
  {\noindent\large\bfseries Part #1\par}%
  \vspace{0.06cm}%
  {\noindent\LARGE\bfseries #2\par}%
  \vspace{0.34cm}%
  \hrule height 0.4pt
  \vspace{0.52cm}%
}
\newcommand{\relatedbooks}[1]{\ifstrempty{#1}{}{\noindent\small Related Books: #1\par\vspace{0.62cm}}}

% Mathematical environments follow MATH200.
\newtheoremstyle{conceptplain}{6pt}{6pt}{\itshape}{}{\bfseries}{}{\newline}{\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\newtheoremstyle{conceptdefinition}{6pt}{6pt}{}{}{\bfseries}{}{\newline}{\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\newtheoremstyle{conceptsameline}{6pt}{6pt}{}{}{\itshape}{.}{0.5em}{\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\theoremstyle{conceptdefinition}
\newtheorem{definition}[mathitem]{Definition}
\newtheorem{example}[mathitem]{Example}
\newtheorem{counterexample}[mathitem]{Counterexample}
\newtheorem{formula}[mathitem]{Formula}
\theoremstyle{conceptplain}
\newtheorem{theorem}[mathitem]{Theorem}
\newtheorem{proposition}[mathitem]{Proposition}
\newtheorem{lemma}[mathitem]{Lemma}
\newtheorem{corollary}[mathitem]{Corollary}
\theoremstyle{conceptsameline}
\newtheorem*{remark}{Remark}
\renewenvironment{proof}[1][Proof]{\par\Needspace{3\baselineskip}\noindent\textit{#1.}\hspace{0.5em}\ignorespaces}{\hfill$\square$\par}
\newcommand{\conceptblockspace}{\Needspace{4\baselineskip}}
\BeforeBeginEnvironment{definition}{\conceptblockspace}
\BeforeBeginEnvironment{example}{\conceptblockspace}
\BeforeBeginEnvironment{counterexample}{\conceptblockspace}
\BeforeBeginEnvironment{formula}{\conceptblockspace}
\BeforeBeginEnvironment{theorem}{\conceptblockspace}
\BeforeBeginEnvironment{proposition}{\conceptblockspace}
\BeforeBeginEnvironment{lemma}{\conceptblockspace}
\BeforeBeginEnvironment{corollary}{\conceptblockspace}
\BeforeBeginEnvironment{remark}{\conceptblockspace}

