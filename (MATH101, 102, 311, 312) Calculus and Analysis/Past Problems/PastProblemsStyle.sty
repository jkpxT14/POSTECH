\newcounter{course}
\newcounter{problemitem}
\renewcommand{\theproblemitem}{\arabic{course}.\arabic{problemitem}}
\renewcommand{\theHproblemitem}{\arabic{course}.\arabic{problemitem}}

\newcommand{\problemheading}[1]{%
  \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
  \textbf{Problem \theproblemitem.}%
  \ifstrempty{#1}{}{\textbf{ (#1).}}%
  \hspace{0.5em}\ignorespaces
}
\newenvironment{problem}[1][]
  {\refstepcounter{problemitem}\problemheading{#1}}
  {\par\vspace{6pt}}
\newenvironment{solution}
  {\par\Needspace{3\baselineskip}\vspace{6pt}\noindent\textit{Solution.}\hspace{0.5em}\ignorespaces}
  {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}

% Compatibility with the previous paired-source shell. The current sources do
% not contain solution bodies, but keeping this flag makes migration lossless.
\newif\ifCASolutions
\CASolutionsfalse

% Four-course division: a minimal extension of the single-course MATH200 design.
\newcommand{\coursepart}[2]{%
  \clearpage
  \setcounter{course}{#1}%
  \setcounter{problemitem}{0}%
  \phantomsection
  \addcontentsline{toc}{part}{Part #1\space #2}%
  \thispagestyle{plain}%
  \vspace*{0.22cm}%
  {\noindent\large\bfseries Part #1\par}%
  \vspace{0.06cm}%
  {\noindent\LARGE\bfseries #2\par}%
  \vspace{0.34cm}%
  \hrule height 0.4pt
  \vspace{0.52cm}%
}

% Compact polar grid used by preserved source problems.
\newcommand{\polargrid}{%
  \foreach \r in {1,2,3,4}{\draw[gray!38,line width=0.25pt] (0,0) circle (\r);}%
  \foreach \a in {0,30,...,330}{\draw[gray!32,line width=0.25pt] (0,0) -- (\a:4);}%
  \foreach \r in {1,2,3,4}{\node[font=\tiny,fill=white,inner sep=0.25pt] at (0:\r) {\r};}%
  \foreach \a in {0,30,...,330}{\node[font=\tiny] at (\a:4.42) {\a};}%
}

