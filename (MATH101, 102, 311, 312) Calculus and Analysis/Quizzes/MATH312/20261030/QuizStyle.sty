\DeclareRobustCommand{\PohangUniversityOfScienceAndTechnology}{\institutiontext{POSTECHRed}{Pohang University of Science and Technology}}

\newcommand{\quiztitle}[1]{%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{1.1cm}
    {\LARGE\bfseries #1\par}
    \vspace{0.25cm}
    {\large for (MATH312) Analysis II\par}
    \vspace{0.75cm}
    {\normalsize Jungwoo Kim\\Department of Mathematics\\\PohangUniversityOfScienceAndTechnology\par}
  \end{center}
  \vspace{0.45cm}
}

\newcommand{\exerciseheading}[1]{%
  \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
  \textbf{Exercise #1.}\hspace{0.5em}\ignorespaces
}
\newenvironment{exercise}[1]
  {\exerciseheading{#1}}
  {\par\vspace{6pt}}
\newenvironment{solution}
  {\par\Needspace{3\baselineskip}\vspace{6pt}\noindent\textit{Solution.}\hspace{0.5em}\ignorespaces}
  {\par\nobreak\noindent\hfill\ordinaryqed\par\vspace{6pt}}
\newlist{exercisesubparts}{enumerate}{1}
\setlist[exercisesubparts]{label=(\alph*),leftmargin=2.5em,labelsep=0.6em,itemsep=0.3em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}

