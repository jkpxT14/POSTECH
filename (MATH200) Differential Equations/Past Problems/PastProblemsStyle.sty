% MATH000 canonical notation: declare only commands used by the problem sources.
\newcommand{\N}{\mathbb{N}}
\newcommand{\Nzero}{\mathbb{N}_0}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\DeclareMathOperator{\arccot}{arccot}

\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{label=(\arabic*),leftmargin=2.5em,labelsep=0.6em,itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{label=(\alph*),leftmargin=2.5em,labelsep=0.6em,itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\newlist{problemclauses}{enumerate}{1}
\setlist[problemclauses]{label=(\roman*),leftmargin=2.5em,labelsep=0.6em,itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}

\newcounter{problemitem}
\renewcommand{\theproblemitem}{\arabic{problemitem}}
\renewcommand{\theHproblemitem}{\arabic{problemitem}}
\newcommand{\problemheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Problem \theproblemitem.}%
    \ifstrempty{#1}{}{\textbf{ (#1).}}%
    \hspace{0.5em}\ignorespaces
}
\newenvironment{problem}[1][]
  {\refstepcounter{problemitem}\problemheading{#1}}
  {\par\vspace{6pt}}

