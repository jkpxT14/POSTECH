    \institutiontext{KAISTBlue}{Korea Advanced Institute of Science and Technology}%
}
\DeclareRobustCommand{\SNU}{\institutiontext{SNUBlue}{SNU}}
\DeclareRobustCommand{\SeoulNationalUniversity}{%
    \institutiontext{SNUBlue}{Seoul National University}%
}

