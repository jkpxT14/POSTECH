% Problem environments
\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{
    label=(\arabic*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{
    label=(\alph*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newcounter{problemitem}
\renewcommand{\theproblemitem}{\arabic{problemitem}}
\renewcommand{\theHproblemitem}{\arabic{problemitem}}

\newcommand{\problemheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Problem \theproblemitem.}%
    \ifstrempty{#1}{}{\textbf{ (#1).}}%
    \hspace{0.5em}\ignorespaces
}

\newenvironment{problem}[1][]
    {\refstepcounter{problemitem}\problemheading{#1}}
    {\par\vspace{6pt}}

\newenvironment{solution}
    {\par\Needspace{3\baselineskip}\vspace{6pt}\noindent\textit{Solution.}\hspace{0.5em}\ignorespaces}
    {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}

% Compatibility with the established single-course MATH200 source family.
\newcommand{\coursepart}[2]{}
\newif\ifCourseSolutions
\CourseSolutionsfalse

