\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{QuizStyle}[2026/10/12 MATH210 quiz style]

% Design follows the established MATH200/MATH230/MATH261 quiz document family.
% Mathematical notation and writing follow the current (MATH000) Mathematical Language.
\RequirePackage[a4paper,margin=1in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{etoolbox}
\RequirePackage{needspace}

% Mathematics
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}
\RequirePackage{dsfont}

% Lists and tables
\RequirePackage{enumitem}
\RequirePackage{booktabs}

% Color and PDF metadata
\RequirePackage{xcolor}
\RequirePackage[hidelinks]{hyperref}

% Institution colors
\definecolor{POSTECHRed}{RGB}{166,25,85}
\definecolor{KAISTBlue}{RGB}{0,65,145}
\definecolor{SNUBlue}{RGB}{15,15,112}
\newcommand{\institutiontext}[2]{%
    \texorpdfstring{\textcolor{#1}{#2}}{#2}%
}
\DeclareRobustCommand{\POSTECH}{\institutiontext{POSTECHRed}{POSTECH}}
\DeclareRobustCommand{\PohangUniversityOfScienceAndTechnology}{%
    \institutiontext{POSTECHRed}{Pohang University of Science and Technology}%
}
\DeclareRobustCommand{\KAIST}{\institutiontext{KAISTBlue}{KAIST}}
\DeclareRobustCommand{\SNU}{\institutiontext{SNUBlue}{SNU}}

% Quiz title block
\newcommand{\quiztitle}[1]{%
    \thispagestyle{empty}%
    \begin{center}
        \vspace*{1.1cm}

        {\LARGE\bfseries #1\par}

        \vspace{0.25cm}

        {\large for (MATH210) Applied Complex Variables\par}

        \vspace{0.75cm}

        {\normalsize
        Jungwoo Kim\\
        Department of Mathematics\\
        \PohangUniversityOfScienceAndTechnology
        \par}
    \end{center}

    \vspace{0.45cm}
}

% Textbook exercises retain their original Section.Exercise identifiers.
\newcommand{\exerciseheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Exercise #1.}\hspace{0.5em}\ignorespaces
}

\newenvironment{exercise}[1]
    {\exerciseheading{#1}}
    {\par\vspace{6pt}}

\newenvironment{solution}
    {\par\Needspace{3\baselineskip}\vspace{6pt}\noindent\textit{Solution.}\hspace{0.5em}\ignorespaces}
    {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}

\newenvironment{suggestion}
    {\par\Needspace{2\baselineskip}\vspace{2pt}\noindent\textit{Suggestion.}\hspace{0.5em}\ignorespaces}
    {\par\vspace{3pt}}

\newenvironment{remark}
    {\par\Needspace{3\baselineskip}\vspace{4pt}\noindent\textit{Remark.}\hspace{0.5em}\ignorespaces}
    {\par\vspace{6pt}}

\newlist{exercisesubparts}{enumerate}{1}
\setlist[exercisesubparts]{
    label=(\alph*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.3em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

% Canonical notation following current MATH000.
\newcommand{\N}{\mathbb{N}}
\newcommand{\Nzero}{\mathbb{N}_0}
\newcommand{\Z}{\mathbb{Z}}
\newcommand{\Q}{\mathbb{Q}}
\newcommand{\R}{\mathbb{R}}
\newcommand{\C}{\mathbb{C}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\DeclareMathOperator{\Arg}{Arg}
\DeclareMathOperator{\Log}{Log}
\DeclareMathOperator{\RePart}{Re}
\DeclareMathOperator{\ImPart}{Im}

