% All numbered mathematical items share one counter; no chapter/section division.
\newcounter{mathitem}
\renewcommand{\themathitem}{\arabic{mathitem}}
\newtheoremstyle{conceptplain}{6pt}{6pt}{\itshape}{}{\bfseries}{}{\newline}{\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\newtheoremstyle{conceptdefinition}{6pt}{6pt}{}{}{\bfseries}{}{\newline}{\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\newtheoremstyle{conceptsameline}{6pt}{6pt}{}{}{\itshape}{.}{0.5em}{\thmname{#1}\thmnumber{ #2}\thmnote{. #3}}
\theoremstyle{conceptdefinition}
\newtheorem{definition}[mathitem]{Definition}
\newtheorem{notation}[mathitem]{Notation}
\newtheorem{example}[mathitem]{Example}
\newtheorem{counterexample}[mathitem]{Counterexample}
\newtheorem{formula}[mathitem]{Formula}
\theoremstyle{conceptplain}
\newtheorem{theorem}[mathitem]{Theorem}
\newtheorem{proposition}[mathitem]{Proposition}
\newtheorem{lemma}[mathitem]{Lemma}
\newtheorem{corollary}[mathitem]{Corollary}
\theoremstyle{conceptsameline}
\newtheorem*{remark}{Remark}
\renewenvironment{proof}[1][Proof]{\par\Needspace{3\baselineskip}\noindent\textit{#1.}\hspace{0.5em}\ignorespaces}{\unskip\hfill$\square$\par}
