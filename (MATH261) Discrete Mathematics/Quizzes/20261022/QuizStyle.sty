\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{QuizStyle}[2026/10/06 MATH261 quiz style]

% Design follows the established MATH200 quiz document family.
% Mathematical notation and writing follow (MATH000) Mathematical Language.
\RequirePackage[a4paper,margin=1in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{etoolbox}
\RequirePackage{needspace}

% Mathematics
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}
\RequirePackage{dsfont}

% Lists and tables
\RequirePackage{enumitem}
\RequirePackage{booktabs}

% Color and PDF metadata
\RequirePackage{xcolor}
\RequirePackage[hidelinks]{hyperref}

% Institution colors
\definecolor{POSTECHRed}{RGB}{166,25,85}
\definecolor{KAISTBlue}{RGB}{0,65,145}
\definecolor{SNUBlue}{RGB}{15,15,112}
\newcommand{\institutiontext}[2]{%
    \texorpdfstring{\textcolor{#1}{#2}}{#2}%
}
\DeclareRobustCommand{\POSTECH}{\institutiontext{POSTECHRed}{POSTECH}}
\DeclareRobustCommand{\PohangUniversityOfScienceAndTechnology}{%
    \institutiontext{POSTECHRed}{Pohang University of Science and Technology}%
}
\DeclareRobustCommand{\KAIST}{\institutiontext{KAISTBlue}{KAIST}}
\DeclareRobustCommand{\SNU}{\institutiontext{SNUBlue}{SNU}}

% Quiz title block.
\newcommand{\quiztitle}[1]{%
    \thispagestyle{empty}%
    \begin{center}
        \vspace*{1.1cm}

        {\LARGE\bfseries #1\par}

        \vspace{0.25cm}

        {\large for (MATH261) Discrete Mathematics\par}

        \vspace{0.75cm}

        {\normalsize
        Jungwoo Kim\\
        Department of Mathematics\\
        \PohangUniversityOfScienceAndTechnology
        \par}
    \end{center}

    \vspace{0.45cm}
}

% Same-line Problem style from the established MATH200 quiz documents.
\newcommand{\problemheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Problem #1.}\hspace{0.5em}\ignorespaces
}

\newenvironment{problem}[2][]
    {%
        \if\relax\detokenize{#1}\relax
            \problemheading{#2}%
        \else
            \problemheading{#2.\ (#1)}%
        \fi
    }
    {\par\vspace{6pt}}

% Ordinary solutions follow the current MATH000 convention and end with \square.
% An optional argument numbers genuinely distinct solutions.
\newenvironment{solution}[1][]
    {%
        \par\Needspace{3\baselineskip}\vspace{6pt}\noindent
        \ifstrempty{#1}{\textit{Solution.}}{\textit{Solution #1.}}%
        \hspace{0.5em}\ignorespaces
    }
    {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}

% Remarks are reserved for useful mathematical context, names, or natural extensions.
\newenvironment{remark}
    {%
        \par\Needspace{3\baselineskip}\vspace{4pt}\noindent
        \textit{Remark.}\hspace{0.5em}\ignorespaces
    }
    {\par\vspace{6pt}}


\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{
    label=(\arabic*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{
    label=(\alph*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.3em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

