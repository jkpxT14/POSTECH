\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{QuizStyle}[2026/10/21 MATH301 quiz style]
% Matches the existing MATH301 quiz design in jkpxT14/POSTECH.
\RequirePackage[a4paper,margin=1in]{geometry}
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage{microtype}
\RequirePackage{etoolbox}
\RequirePackage{needspace}
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}
\RequirePackage{dsfont}
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{array}
\RequirePackage{tikz}
\RequirePackage{xcolor}
\RequirePackage[hidelinks]{hyperref}
\definecolor{POSTECHRed}{RGB}{166,25,85}
\definecolor{KAISTBlue}{RGB}{0,65,145}
\definecolor{SNUBlue}{RGB}{15,15,112}
\newcommand{\institutiontext}[2]{\texorpdfstring{\textcolor{#1}{#2}}{#2}}
\DeclareRobustCommand{\POSTECH}{\institutiontext{POSTECHRed}{POSTECH}}
\DeclareRobustCommand{\PohangUniversityOfScienceAndTechnology}{\institutiontext{POSTECHRed}{Pohang University of Science and Technology}}
\DeclareRobustCommand{\KAIST}{\institutiontext{KAISTBlue}{KAIST}}
\DeclareRobustCommand{\SNU}{\institutiontext{SNUBlue}{SNU}}
\newcommand{\quiztitle}[1]{%
    \thispagestyle{empty}%
    \begin{center}
        \vspace*{1.1cm}
        {\LARGE\bfseries #1\par}
        \vspace{0.25cm}
        {\large for (MATH301) Modern Algebra I\par}
        \vspace{0.75cm}
        {\normalsize
        Jungwoo Kim\\
        Department of Mathematics\\
        \PohangUniversityOfScienceAndTechnology
        \par}
    \end{center}
    \vspace{0.45cm}
}
\newcommand{\exerciseheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Exercise #1.}\hspace{0.5em}\ignorespaces
}
\newenvironment{exercise}[2][]{%
    \if\relax\detokenize{#1}\relax
        \exerciseheading{#2}%
    \else
        \exerciseheading{#2.\ (#1)}%
    \fi
}{\par\vspace{6pt}}
\newcommand{\supplementaryexerciseheading}{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Supplementary Exercise.}\hspace{0.5em}\ignorespaces
}
\newenvironment{supplementaryexercise}{\supplementaryexerciseheading}{\par\vspace{6pt}}
\newcommand{\ordinaryqed}{\ensuremath{\square}}
\newenvironment{solution}[1][]{%
    \par\Needspace{3\baselineskip}\vspace{6pt}\noindent
    \ifstrempty{#1}{\textit{Solution.}}{\textit{Solution #1.}}%
    \hspace{0.5em}\ignorespaces
}{\par\nobreak\noindent\hfill\ordinaryqed\par\vspace{6pt}}
\newenvironment{notation}{%
    \par\Needspace{3\baselineskip}\vspace{2pt}\noindent
    \textit{Notation.}\hspace{0.5em}\ignorespaces
}{\par\vspace{4pt}}
\newenvironment{hint}{%
    \par\Needspace{2\baselineskip}\vspace{2pt}\noindent
    \textit{Hint.}\hspace{0.5em}\ignorespaces
}{\par\vspace{4pt}}
\newlist{exercisechoices}{enumerate}{1}
\setlist[exercisechoices]{label=(\arabic*),leftmargin=2.5em,labelsep=0.6em,itemsep=0.15em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
\newlist{exercisesubparts}{enumerate}{1}
\setlist[exercisesubparts]{label=(\alph*),leftmargin=2.5em,labelsep=0.6em,itemsep=0.25em,topsep=0.4em,parsep=0pt,partopsep=0pt,align=left}
