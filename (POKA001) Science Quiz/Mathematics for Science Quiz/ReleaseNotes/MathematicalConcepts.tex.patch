+        without solving for the individual roots. Differentiating gives
+        \[
+            \sum_{i=1}^{n}\frac1{(t-r_i)^2}
+            =\left(\frac{p'(t)}{p(t)}\right)^2-\frac{p''(t)}{p(t)}.
+        \]
     \end{formula}
 
