+    \begin{corollary}[Eigenvalues of Rectangular Products]\label{r4:ab-ba}
+        For $\mathbf{A}\in\C^{m\times n}$ and $\mathbf{B}\in\C^{n\times m}$
+        with $m\leq n$,
+        \[
