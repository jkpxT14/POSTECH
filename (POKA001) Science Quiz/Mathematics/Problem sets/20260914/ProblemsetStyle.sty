\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ProblemsetStyle}[2026/09/24 Science Quiz problem set style]

% Science Quiz Problem sets use the MATH200 Quiz layout as their visual
% baseline, adapted to a Korean document. Mathematical notation follows the
% current (MATH000) Mathematical Language.

% Page layout and Korean typography
\RequirePackage[a4paper,margin=1in]{geometry}
\RequirePackage{fontspec}
\RequirePackage{xetexko}
\IfFontExistsTF{Noto Serif CJK KR}
    {\setmainhangulfont[AutoFakeSlant=0.2]{Noto Serif CJK KR}}
    {}
\IfFontExistsTF{Noto Sans CJK KR}
    {\setsanshangulfont{Noto Sans CJK KR}}
    {}
\RequirePackage{microtype}
\microtypesetup{protrusion=false,expansion=false}
\RequirePackage{etoolbox}
\RequirePackage{environ}
\RequirePackage{needspace}

% Mathematics
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}
\RequirePackage{dsfont}

% Lists
\RequirePackage{enumitem}

% Color and PDF metadata
\RequirePackage{xcolor}
\RequirePackage[unicode,hidelinks]{hyperref}

% Institution colors used by the current problem sets
\definecolor{POSTECHRed}{RGB}{166,25,85}
\definecolor{KAISTBlue}{RGB}{0,65,145}
\definecolor{MITRed}{RGB}{117,0,20}
\newcommand{\institutiontext}[2]{%
    \texorpdfstring{\textcolor{#1}{#2}}{#2}%
}
\DeclareRobustCommand{\POSTECHKorean}{%
    \institutiontext{POSTECHRed}{포항공과대학교}%
}
\DeclareRobustCommand{\KAIST}{\institutiontext{KAISTBlue}{KAIST}}
\DeclareRobustCommand{\MIT}{\institutiontext{MITRed}{MIT}}

% Title block: spacing mirrors the MATH200 Quiz document.
\newcommand{\problemsettitle}[1]{%
    \thispagestyle{empty}%
    \begin{center}
        \vspace*{1.1cm}

        {\LARGE\bfseries #1\par}

        \vspace{0.25cm}

        {\large for Science Quiz\par}

        \vspace{0.75cm}

        {\normalsize
        김정우\\
        \POSTECHKorean{} 수학과
        \par}
    \end{center}

    \vspace{0.45cm}
}

% Problems use the same-line heading style of the MATH200 Quiz.
\newcommand{\problemheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Problem #1.}\hspace{0.5em}\ignorespaces
}

% The optional argument is reserved for a compact official source or an
% established problem name. The second argument is the displayed problem number.
\newenvironment{problem}[2][]
    {%
        \if\relax\detokenize{#1}\relax
            \problemheading{#2}%
        \else
            \problemheading{#2.\ (#1)}%
        \fi
    }
    {\par\vspace{6pt}}

% One canonical content file produces both documents. Problems mode suppresses
% solution bodies; Solutions mode prints each problem immediately followed by
% its solution.
\newif\ifProblemsetSolutions
\ProblemsetSolutionsfalse

\newbool{multiplesolutions}
\newcounter{solutionmethod}

\newcommand{\solutionheading}{%
    \ifbool{multiplesolutions}
        {%
            \stepcounter{solutionmethod}%
            \textit{Solution \arabic{solutionmethod}.}%
        }
        {%
            \textit{Solution.}%
        }%
}

\NewEnviron{solution}{%
    \ifProblemsetSolutions
        \par\Needspace{3\baselineskip}\vspace{6pt}\noindent
        \solutionheading\hspace{0.5em}\ignorespaces
        \BODY
        \par\nobreak\noindent\hfill$\square$\par\vspace{6pt}%
    \fi
}

% Use this wrapper only when one problem genuinely has multiple distinct
% solution methods. Ordinary solutions remain simply "Solution.".
\NewEnviron{solutions}{%
    \ifProblemsetSolutions
        \setcounter{solutionmethod}{0}%
        \booltrue{multiplesolutions}%
        \BODY
        \boolfalse{multiplesolutions}%
    \fi
}

% Independent choices and connected subparts follow the shared problem-document
% convention used elsewhere in the repository.
\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{
    label=(\arabic*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{
    label=(\alph*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

