% Problem environments
% Problems are numbered automatically, restarting from 1 in each of the two
% sections: Past Problems and Expected Problems. Each problem is stored next to
% its solution. When one problem has genuinely different solution methods, wrap
% its solution environments in solutions; they are then labeled Solution 1,
% Solution 2, ... automatically. Ordinary solutions remain labeled simply
% Solution. Solution numbering is local to the alternative methods for one
% problem and is never tied to the problem number.
%
% The optional argument contains only a compact, independently verifiable
% official source and/or an established standard problem name. Internal study
% documents and invented descriptive labels are not sources; omit the optional
% argument when no qualifying attribution is known.
\newcommand{\problemheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Problem #1.}\hspace{0.5em}\ignorespaces
}

% Independent choices, clues, assumptions, and ordered statements use
% (1), (2), (3), ...; connected subparts use (a), (b), (c), ....
\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{
    label=(\arabic*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{
    label=(\alph*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newcounter{problemsection}
\newcounter{problem}
\renewcommand{\theHproblem}{%
    \arabic{problemsection}.\arabic{problem}%
}

\newenvironment{problem}[1][]
    {%
        \refstepcounter{problem}%
        \if\relax\detokenize{#1}\relax
            \problemheading{\theproblem}%
        \else
            \problemheading{\theproblem.\ (#1)}%
        \fi
    }
    {\par\vspace{6pt}}

\newbool{multiplesolutions}
\newcounter{solutionmethod}

\newenvironment{solutions}
    {%
        \setcounter{solutionmethod}{0}%
        \booltrue{multiplesolutions}%
    }
    {%
        \boolfalse{multiplesolutions}%
    }

\newcommand{\solutionheading}{%
    \ifbool{multiplesolutions}
        {%
            \stepcounter{solutionmethod}%
            \textit{Solution \arabic{solutionmethod}.}%
        }
        {%
            \textit{Solution.}%
        }%
}

\newenvironment{solution}
    {%
        \par\Needspace{3\baselineskip}\vspace{6pt}\noindent
        \solutionheading
        \hspace{0.5em}\ignorespaces
    }
    {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}

% Numbered document sections with unnumbered running heads. Problem numbering
% restarts from 1 in each section.
\newcommand{\problemsection}[1]{%
    \clearpage
    \section{#1}%
    \markboth{#1}{#1}%
    \stepcounter{problemsection}%
    \setcounter{problem}{0}%
}

