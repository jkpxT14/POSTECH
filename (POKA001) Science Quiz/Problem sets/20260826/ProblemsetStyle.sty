\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ProblemsetStyle}[2026/08/20 Science Quiz problem set style]

% Standalone adaptation of the current Mathematics for Science Quiz typography.
% The handbook itself remains English-only. Problem sets may use Korean.
% This package is intentionally engine-compatible: the same source compiles with
% the user's ordinary latexmk/pdfLaTeX workflow and also with XeLaTeX/LuaLaTeX.

% Page layout and typography
\RequirePackage[a4paper,margin=1in]{geometry}
\RequirePackage{iftex}
\ifPDFTeX
    % TeX Live's ko.TeX support makes UTF-8 Korean work under pdfLaTeX.
    \RequirePackage{kotex}
\else
    \RequirePackage{fontspec}
    \ifXeTeX
        \RequirePackage{xetexko}
    \else
        \RequirePackage{luatexko}
    \fi
    \IfFontExistsTF{Noto Serif CJK KR}
        {\setmainhangulfont[AutoFakeSlant=0.2]{Noto Serif CJK KR}}
        {}
    \IfFontExistsTF{Noto Sans CJK KR}
        {\setsanshangulfont{Noto Sans CJK KR}}
        {}
\fi
\RequirePackage{microtype}
\ifPDFTeX\else
    \microtypesetup{protrusion=false,expansion=false}
\fi
\RequirePackage{etoolbox}
\RequirePackage{needspace}

% Mathematics
\RequirePackage{amsmath,amssymb,amsthm}
\RequirePackage{mathtools}

% Lists
\RequirePackage{enumitem}

% Color and PDF metadata
\RequirePackage{xcolor}
\RequirePackage[unicode,hidelinks]{hyperref}

% Institution color copied from the current handbook source.
\definecolor{POSTECHRed}{RGB}{166,25,85}
\newcommand{\POSTECHKorean}{\textcolor{POSTECHRed}{포항공과대학교}}

% Problem-set title block
\newcommand{\problemsettitle}[1]{%
    \begin{center}
        \vspace*{1.15cm}
        {\LARGE\bfseries #1\par}
        \vspace{0.65cm}
        {\large 김정우\par}
        \vspace{0.18cm}
        {\large \POSTECHKorean{} 수학과\par}
    \end{center}
    \vspace{1.05cm}
}

% Problem environments follow the current handbook's same-line Problem style.
\newcommand{\problemheading}[1]{%
    \par\Needspace{4\baselineskip}\vspace{6pt}\noindent
    \textbf{Problem #1.}\hspace{0.5em}\ignorespaces
}

\newenvironment{problem}[1]
    {\problemheading{#1}}
    {\par\vspace{6pt}}

% The separate solutions booklet keeps the handbook's italic Solution label,
% with an explicit problem number so each solution is identifiable on its own.
\newcommand{\solutionheading}[1]{%
    \par\Needspace{3\baselineskip}\vspace{6pt}\noindent
    \textit{Solution #1.}\hspace{0.5em}\ignorespaces
}

\newenvironment{problemsolution}[1]
    {\solutionheading{#1}}
    {\par\nobreak\noindent\hfill$\square$\par\vspace{6pt}}

% Lists inside problems use the current handbook's role-specific numbering.
\newlist{problemchoices}{enumerate}{1}
\setlist[problemchoices]{
    label=(\arabic*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

\newlist{problemsubparts}{enumerate}{1}
\setlist[problemsubparts]{
    label=(\alph*),
    leftmargin=2.5em,
    labelsep=0.6em,
    itemsep=0.15em,
    topsep=0.4em,
    parsep=0pt,
    partopsep=0pt,
    align=left
}

% Notation used in this problem set, matching the handbook conventions.
\newcommand{\C}{\mathbb{C}}
\newcommand{\dd}{\mathop{}\!\mathrm{d}}
\DeclareMathOperator{\proj}{proj}
